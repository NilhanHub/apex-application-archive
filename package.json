{
  "name": "apex-application-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emulator": "firebase emulators:exec --project apex-application-archive-test --only firestore,storage \"npm run test:rules\"",
    "test:plugin": "php wordpress-plugin/apex-forminator-bridge/tests/normalization-test.php",
    "test:all": "npm test && npm --prefix functions test",
    "verify": "npm run test:plugin && npm test && npm --prefix functions test && npm run test:rules:emulator && npm run typecheck && npm --prefix functions run typecheck && npm run build && npm --prefix functions run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.18.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
