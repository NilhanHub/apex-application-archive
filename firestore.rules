rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function approved() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.approved == true
        && get(userPath()).data.active == true;
    }

    function owner() {
      return approved() && get(userPath()).data.role == 'owner';
    }

    function validRecruiterState() {
      let state = request.resource.data.recruiter;
      return state is map
        && state.keys().hasOnly(['stage', 'tags', 'assignedTo', 'favorite', 'lastReviewedAt'])
        && state.stage in ['New', 'Review', 'Shortlisted', 'Contacted', 'Interview', 'Hold', 'Rejected', 'Placed']
        && state.tags is list
        && state.tags.size() <= 30
        && (state.assignedTo == null || state.assignedTo is string)
        && state.favorite is bool
        && (state.lastReviewedAt == null || state.lastReviewedAt is timestamp);
    }

    match /users/{uid} {
      allow read: if approved() && (request.auth.uid == uid || owner());
      allow create, update, delete: if owner();
    }

    match /applications/{applicationId} {
      allow read: if approved();
      allow create, delete: if false;
      allow update: if approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recruiter', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validRecruiterState();
    }

    match /syncRuns/{runId} {
      allow read: if approved();
      allow write: if false;
    }

    match /syncState/{stateId} {
      allow read: if approved();
      allow write: if false;
    }

    match /syncLocks/{lockId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
