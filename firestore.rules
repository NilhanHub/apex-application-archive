rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.approved == true;
    }

    function owner() {
      return approved() && userDoc().data.role == "owner";
    }

    match /users/{uid} {
      allow read: if approved() && (request.auth.uid == uid || owner());
      allow create, update, delete: if owner();
    }

    match /candidates/{candidateId} {
      allow read: if approved();
      allow create, update, delete: if owner();

      match /notes/{noteId} {
        allow read, create: if approved();
        allow update, delete: if owner();
      }
    }

    match /aiSummaries/{candidateId} {
      allow read: if approved();
      allow write: if owner();
    }

    match /searchDocuments/{candidateId} {
      allow read: if approved();
      allow write: if owner();
    }

    match /importRuns/{runId} {
      allow read: if approved();
      allow write: if owner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
