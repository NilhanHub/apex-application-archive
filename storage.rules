rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'authorized-user-2@example.test',
          'authorized-user-3@example.test',
          'authorized-user-4@example.test'
        ];
    }

    match /cvs/2989/{entryId}/{fileName} {
      allow read: if approved();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
